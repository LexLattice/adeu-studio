  "required": [
    "intent_edge_decomposition_id",
    "semantic_intent_contract_id",
    "intent_source_index_id",
    "intent_non_implementation_guardrail_id",
    "review_id",
    "snapshot_id",
    "source_set_id",
    "edge_decomposition_rows",
    "edge_decomposition_summary"
  ],
  "title": "RepoIntentEdgeDecomposition",
  "type": "object"
}
