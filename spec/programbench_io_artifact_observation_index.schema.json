    "artifact_visibility_rows": {
      "items": {
        "$ref": "#/$defs/ProgrambenchIOArtifactVisibilityRow"
      },
      "minItems": 1,
      "title": "Artifact Visibility Rows",
      "type": "array"
    },
    "binary_output_artifact_refs": {
      "items": {
        "type": "string"
      },
      "title": "Binary Output Artifact Refs",
      "type": "array"
    },
    "directory_output_artifact_refs": {
      "items": {
        "type": "string"
      },
      "title": "Directory Output Artifact Refs",
      "type": "array"
    },
    "generated_output_artifact_refs": {
      "items": {
        "type": "string"
      },
      "title": "Generated Output Artifact Refs",
      "type": "array"
    },
    "io_artifact_index_ref": {
      "title": "Io Artifact Index Ref",
      "type": "string"
    },
    "limitation_note": {
      "title": "Limitation Note",
