    "semantic_declaration_source_index_id": {
      "title": "Semantic Declaration Source Index Id",
      "type": "string"
    },
    "semantic_operator_class_registry_id": {
      "title": "Semantic Operator Class Registry Id",
      "type": "string"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_set_id": {
      "title": "Source Set Id",
      "type": "string"
    },
    "turn_semantic_declaration_request_id": {
      "title": "Turn Semantic Declaration Request Id",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "semantic_operator_class_registry_id",
    "semantic_declaration_source_index_id",
    "turn_semantic_declaration_request_id",
    "semantic_declaration_non_authority_guardrail_id",
    "review_id",
    "snapshot_id",
    "source_set_id",
    "registry_rows",
    "registry_summary"
  ],
  "title": "RepoSemanticOperatorClassRegistry",
  "type": "object"
