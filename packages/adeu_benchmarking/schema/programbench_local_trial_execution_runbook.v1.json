            "sandbox_witness_bundle",
            "stderr_hash_and_bounded_excerpt",
            "stdout_hash_and_bounded_excerpt",
            "tool_manifest_hashes"
          ],
          "title": "Capture Kind",
          "type": "string"
        },
        "capture_obligation_ref": {
          "title": "Capture Obligation Ref",
          "type": "string"
        },
        "capture_scope_posture": {
          "const": "required_for_later_pb_trial_0b",
          "title": "Capture Scope Posture",
          "type": "string"
        },
        "limitation_note": {
          "title": "Limitation Note",
          "type": "string"
        },
        "witness_requirement_refs": {
          "items": {
            "type": "string"
