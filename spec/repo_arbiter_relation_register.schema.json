          "title": "Relation Review Posture",
          "type": "string"
        },
        "required_next_review_surface": {
          "enum": [
            "future_runtime_permission_review",
            "future_product_review",
            "future_external_branch_review",
            "future_outcome_review",
            "future_reconciliation_or_arbiter_review",
            "future_experiment_review",
            "future_family_review",
            "deferred_no_selection"
          ],
          "title": "Required Next Review Surface",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "source_relation_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Relation Refs",
          "type": "array"
        }
      },
      "required": [
        "arbiter_relation_ref",
        "claim_map_refs",
        "source_relation_refs",
        "relation_kind",
        "relation_review_posture",
        "arbiter_need_posture",
        "required_next_review_surface",
        "source_refs",
        "non_truth_guardrail",
        "limitation_note"
      ],
      "title": "RepoArbiterRelationRow",
      "type": "object"
