  "additionalProperties": false,
  "properties": {
    "canonical_meta_lookup_index_id": {
      "title": "Canonical Meta Lookup Index Id",
      "type": "string"
    },
    "obligation_family_registry_id": {
      "title": "Obligation Family Registry Id",
      "type": "string"
    },
    "review_id": {
      "title": "Review Id",
      "type": "string"
    },
