          "type": "string"
        },
        "tool_id": {
          "title": "Tool Id",
          "type": "string"
        },
        "tool_matrix_ref": {
          "title": "Tool Matrix Ref",
          "type": "string"
        },
        "worker_role_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Worker Role Refs",
          "type": "array"
        }
      },
      "required": [
        "tool_matrix_ref",
        "worker_role_refs",
        "tool_id",
        "target_claim_refs",
        "target_namespace_kind",
        "claim_horizon",
        "applicability_posture",
        "observed_or_required_result_refs",
        "limitation_note"
      ],
      "title": "RepoWorkerToolApplicabilityRow",
      "type": "object"
