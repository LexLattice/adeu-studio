      "type": "string"
    },
    "target_origin_justification": {
      "title": "Target Origin Justification",
      "type": "string"
    },
    "target_origin_route": {
      "enum": [
        "matrix_member",
        "ready_expanded_case_lineage",
        "direct_adapter_case_exception"
