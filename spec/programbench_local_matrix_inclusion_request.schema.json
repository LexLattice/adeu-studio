            "eligible_lineage_ready",
            "local_matrix_membership_accounting",
            "local_regression_membership_update",
            "local_smoke_membership_update"
          ],
          "title": "Rationale Kind",
          "type": "string"
        },
        "rationale_scope_posture": {
          "const": "local_matrix_inclusion_only_not_quality_selection",
          "title": "Rationale Scope Posture",
          "type": "string"
        },
        "selection_rationale_ref": {
          "title": "Selection Rationale Ref",
          "type": "string"
        }
      },
      "required": [
        "selection_rationale_ref",
        "rationale_kind",
        "candidate_case_lineage_refs",
        "rationale_scope_posture",
        "limitation_note"
      ],
      "title": "ProgrambenchLocalMatrixInclusionSelectionRationaleRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "base_matrix_ref": {
      "title": "Base Matrix Ref",
      "type": "string"
    },
    "base_matrix_revision_hash": {
      "title": "Base Matrix Revision Hash",
      "type": "string"
    },
    "base_matrix_revision_ref": {
      "title": "Base Matrix Revision Ref",
      "type": "string"
    },
    "benchmark_truth_posture": {
      "const": "not_benchmark_truth",
      "title": "Benchmark Truth Posture",
      "type": "string"
    },
    "case_expansion_readiness_summary_ref": {
      "title": "Case Expansion Readiness Summary Ref",
      "type": "string"
    },
    "case_expansion_ref": {
      "title": "Case Expansion Ref",
      "type": "string"
    },
    "case_matrix_candidate_handoff_ref": {
      "title": "Case Matrix Candidate Handoff Ref",
      "type": "string"
    },
    "execution_authority_posture": {
      "const": "no_execution_authority_granted_by_pb_matrix_inclusion_0a",
      "title": "Execution Authority Posture",
      "type": "string"
    },
    "future_family_selection_posture": {
      "const": "no_future_family_selection_authority_granted_by_pb_matrix_inclusion_0a",
      "title": "Future Family Selection Posture",
      "type": "string"
    },
    "limitation_note": {
      "title": "Limitation Note",
      "type": "string"
    },
    "matrix_inclusion_horizon": {
      "enum": [
        "local_matrix_membership_revision",
        "local_regression_matrix_membership_update",
        "local_smoke_matrix_membership_update"
