      "title": "Sandbox Policy Ref",
      "type": "string"
    },
    "sandbox_witness_requirement_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Sandbox Witness Requirement Refs",
      "type": "array"
    },
    "schema": {
      "const": "programbench_local_trial_execution_runbook@1",
      "title": "Schema",
      "type": "string"
    },
    "timeout_policy_ref": {
      "title": "Timeout Policy Ref",
      "type": "string"
    },
    "tool_manifest_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Tool Manifest Refs",
      "type": "array"
