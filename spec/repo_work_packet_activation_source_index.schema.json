{
  "$defs": {
    "RepoGeneratedWorkPacketCandidateRow": {
      "additionalProperties": false,
      "properties": {
        "candidate_authority_posture": {
          "enum": [
            "candidate_only",
            "candidate_blocked_by_missing_v83_projection",
            "candidate_blocked_by_missing_quality_gate",
            "candidate_blocked_by_unbounded_target",
            "candidate_blocked_by_missing_review"
          ],
          "title": "Candidate Authority Posture",
          "type": "string"
        },
        "generated_candidate_ref": {
          "title": "Generated Candidate Ref",
          "type": "string"
        },
        "generated_output_refs": {
          "items": {
            "type": "string"
          },
          "title": "Generated Output Refs",
          "type": "array"
        },
        "generating_actor_kind": {
          "enum": [
            "human_operator",
            "model",
            "agent",
            "reviewer",
            "tool_assisted_review",
            "mixed",
            "unknown"
          ],
          "title": "Generating Actor Kind",
          "type": "string"
        },
        "generation_scope_posture": {
          "enum": [
            "not_generated",
            "generated_for_review_only",
            "generated_from_bounded_context",
            "generated_from_unbounded_context",
            "generated_source_missing",
            "generated_source_unknown"
          ],
          "title": "Generation Scope Posture",
          "type": "string"
        },
        "input_projection_packet_refs": {
          "items": {
            "type": "string"
          },
          "title": "Input Projection Packet Refs",
          "type": "array"
        },
        "input_quality_gate_refs": {
          "items": {
            "type": "string"
          },
          "title": "Input Quality Gate Refs",
          "type": "array"
        },
        "limitation_note": {
          "title": "Limitation Note",
          "type": "string"
        },
        "model_or_agent_profile_refs": {
          "items": {
            "type": "string"
          },
          "title": "Model Or Agent Profile Refs",
          "type": "array"
        },
        "prompt_context_refs": {
          "items": {
            "type": "string"
          },
          "title": "Prompt Context Refs",
          "type": "array"
        },
        "reviewer_amendment_refs": {
          "items": {
            "type": "string"
          },
          "title": "Reviewer Amendment Refs",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "generated_candidate_ref",
        "source_refs",
        "generating_actor_kind",
        "generation_scope_posture",
        "candidate_authority_posture",
        "limitation_note"
      ],
      "title": "RepoGeneratedWorkPacketCandidateRow",
      "type": "object"
    },
    "RepoWorkPacketActivationSourceRow": {
      "additionalProperties": false,
      "properties": {
        "activation_source_role": {
          "enum": [
            "v83_projection_packet_source",
            "v83_quality_gate_source",
            "v83_handoff_source",
            "v83_closeout_source",
            "v83_semantic_edge_context",
            "v83_artifact_obligation_context",
            "generated_work_packet_candidate_review_source",
            "canonical_lock_requirement_source",
            "target_boundary_context_source",
            "read_dependency_context_source",
            "prospective_write_target_context_source",
            "forbidden_target_context_source",
            "morphic_ux_support_context",
            "direct_oai_support_context",
            "meta_orchestrator_support_context",
            "combined_dogfood_context",
            "support_process_context",
            "absence_marker"
          ],
          "title": "Activation Source Role",
          "type": "string"
        },
        "generation_posture": {
          "enum": [
            "not_generated",
            "generated_for_review_only",
            "generated_from_bounded_context",
            "generated_from_unbounded_context",
            "generated_source_missing",
            "generated_source_unknown"
          ],
          "title": "Generation Posture",
          "type": "string"
        },
        "limitation_note": {
          "title": "Limitation Note",
          "type": "string"
        },
        "odeu_lane": {
          "enum": [
            "ontological",
            "deontic",
            "epistemic",
            "utility"
          ],
          "title": "Odeu Lane",
          "type": "string"
        },
        "projection_authority_posture": {
          "enum": [
            "projection_source_for_review_only",
            "quality_gate_source_for_review_only",
            "generated_candidate_source_only",
            "support_context_only",
            "projection_missing",
            "projection_blocked_by_carried_drift",
            "not_applicable"
          ],
          "title": "Projection Authority Posture",
          "type": "string"
        },
        "source_currentness": {
          "enum": [
            "current_released_source",
            "context_only",
            "explicit_absence_marker",
            "stale_or_superseded",
            "unknown_needs_review"
          ],
          "title": "Source Currentness",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "planning_doc",
            "architecture_doc",
            "support_doc",
            "review_input",
            "closeout_doc",
            "evidence_artifact",
            "schema_file",
            "fixture_file",
            "operator_turn",
            "transcript_artifact",
            "model_output",
            "repo_observation",
            "external_artifact"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "source_presence_posture": {
          "enum": [
            "present",
            "missing_expected_support_artifact",
            "not_uploaded_in_review_snapshot",
            "generated_later",
            "external_unavailable",
            "operator_turn_not_committed"
          ],
          "title": "Source Presence Posture",
          "type": "string"
        },
        "source_ref": {
          "title": "Source Ref",
          "type": "string"
        },
        "source_status": {
          "enum": [
            "integrated_shaping_source",
            "available_but_not_integrated",
            "review_pending_input",
            "rejected_or_superseded_source"
          ],
          "title": "Source Status",
          "type": "string"
        },
        "work_packet_authority_posture": {
          "enum": [
            "work_packet_requires_later_lock",
            "work_packet_review_only",
            "no_work_packet_authority_granted",
            "work_packet_forbidden_by_this_family"
          ],
          "title": "Work Packet Authority Posture",
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "source_kind",
        "source_status",
        "source_presence_posture",
        "activation_source_role",
        "source_currentness",
        "projection_authority_posture",
        "work_packet_authority_posture",
        "generation_posture",
        "odeu_lane",
        "limitation_note"
      ],
      "title": "RepoWorkPacketActivationSourceRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "generated_work_packet_candidate_rows": {
      "items": {
        "$ref": "#/$defs/RepoGeneratedWorkPacketCandidateRow"
      },
      "title": "Generated Work Packet Candidate Rows",
      "type": "array"
    },
    "review_id": {
      "title": "Review Id",
      "type": "string"
    },
    "schema": {
      "const": "repo_work_packet_activation_source_index@1",
      "title": "Schema",
      "type": "string"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_index_summary": {
      "title": "Source Index Summary",
      "type": "string"
    },
    "source_rows": {
      "items": {
        "$ref": "#/$defs/RepoWorkPacketActivationSourceRow"
      },
      "minItems": 1,
      "title": "Source Rows",
      "type": "array"
    },
    "source_set_id": {
      "title": "Source Set Id",
      "type": "string"
    },
    "work_packet_activation_source_index_id": {
      "title": "Work Packet Activation Source Index Id",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "work_packet_activation_source_index_id",
    "review_id",
    "snapshot_id",
    "source_set_id",
    "source_rows",
    "source_index_summary"
  ],
  "title": "RepoWorkPacketActivationSourceIndex",
  "type": "object"
}
