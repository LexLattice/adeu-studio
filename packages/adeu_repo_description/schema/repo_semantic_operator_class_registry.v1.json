      "required": [
        "registry_ref",
        "semantic_declaration_session_ref",
        "source_refs",
        "registry_entry_kind",
        "registry_domain",
        "canonical_id",
        "entry_status",
        "entry_currentness",
        "entry_scope_posture",
        "operator_semantics_posture",
        "class_semantics_posture",
        "non_invention_guardrail",
        "limitation_note"
