        "required_evidence_kind": {
          "enum": [
            "schema",
            "validator",
            "positive_fixture",
            "reject_fixture",
            "unit_test",
            "integration_test",
            "documentation",
            "semantic_review",
            "human_review",
            "future_family_review"
