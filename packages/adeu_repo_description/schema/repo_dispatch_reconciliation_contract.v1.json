          "type": "array"
        },
        "contract_ref": {
          "title": "Contract Ref",
          "type": "string"
        },
        "forbidden_inferences": {
          "items": {
            "enum": [
              "worker_output_as_truth",
              "model_output_as_benchmark_truth",
