    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_set_id": {
      "title": "Source Set Id",
      "type": "string"
    }
  },
  "required": [
    "runtime_execution_authority_decision_id",
    "runtime_execution_authority_request_id",
    "runtime_authority_non_action_guardrail_id",
    "review_id",
    "snapshot_id",
    "source_set_id",
    "decision_rows",
    "authority_decision_summary"
  ],
  "title": "RepoRuntimeExecutionAuthorityDecision",
  "type": "object"
}
