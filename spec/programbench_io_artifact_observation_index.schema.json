  "required": [
    "schema",
    "io_artifact_index_ref",
    "probe_observation_refs",
    "task_intake_ref",
    "stdout_artifact_refs",
    "stderr_artifact_refs",
    "generated_output_artifact_refs",
    "directory_output_artifact_refs",
    "binary_output_artifact_refs",
