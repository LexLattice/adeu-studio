      "title": "Trial Docket Ref",
      "type": "string"
    },
    "trial_input_materialization_policy_ref": {
      "title": "Trial Input Materialization Policy Ref",
      "type": "string"
    },
    "trial_runbook_ref": {
      "title": "Trial Runbook Ref",
      "type": "string"
    },
    "worker_input_packet_hash": {
      "title": "Worker Input Packet Hash",
      "type": "string"
    },
    "worker_visible_context_hash": {
      "title": "Worker Visible Context Hash",
      "type": "string"
    },
    "write_scope_refs": {
