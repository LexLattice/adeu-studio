    "review_id": {
      "title": "Review Id",
      "type": "string"
    },
    "schema": {
      "const": "repo_arbiter_relation_register@1",
      "default": "repo_arbiter_relation_register@1",
      "title": "Schema",
      "type": "string"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_set_id": {
      "title": "Source Set Id",
      "type": "string"
    }
  },
  "required": [
    "arbiter_relation_register_id",
    "reconciliation_claim_map_id",
    "review_id",
    "snapshot_id",
    "source_set_id",
    "relation_rows",
    "relation_register_summary"
