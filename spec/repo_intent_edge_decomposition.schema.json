      "title": "Intent Non Implementation Guardrail Id",
      "type": "string"
    },
    "intent_source_index_id": {
      "title": "Intent Source Index Id",
      "type": "string"
    },
    "review_id": {
      "title": "Review Id",
      "type": "string"
    },
    "schema": {
      "const": "repo_intent_edge_decomposition@1",
