      "minItems": 1,
      "title": "Forbidden Step Rows",
      "type": "array"
    },
    "limitation_note": {
      "title": "Limitation Note",
      "type": "string"
    },
    "run_budget_ref": {
      "title": "Run Budget Ref",
      "type": "string"
    },
    "runbook_hash": {
      "title": "Runbook Hash",
      "type": "string"
    },
    "runbook_scope_posture": {
      "const": "execution_plan_only_no_dispatch_by_pb_trial_0a",
      "title": "Runbook Scope Posture",
      "type": "string"
