        "source_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "warning_kind": {
          "enum": [
            "nonblocking_alias_warning",
            "duplicate_preserved_warning",
            "support_context_present_but_not_decisive",
            "optional_obligation_family_unmapped",
            "documentation_alignment_warning",
            "ambiguous_binding",
            "registry_gap",
            "unknown_pointer",
            "missing_guardrail",
            "missing_source_witness",
            "lookup_conflict",
            "support_only_source",
            "invented_class",
            "obligation_expansion_attempt"
          ],
          "title": "Warning Kind",
          "type": "string"
        },
        "warning_ref": {
          "title": "Warning Ref",
          "type": "string"
        }
