          "type": "string"
        },
        "forbidden_step_kind": {
          "enum": [
            "benchmark_scoring",
            "decompilation",
            "external_repo_lookup",
            "hidden_test_access",
            "internet_lookup",
            "model_ranking",
            "official_programbench_runner_contact",
            "official_submission",
            "original_source_lookup",
            "retry_dispatch"
          ],
          "title": "Forbidden Step Kind",
          "type": "string"
        },
        "forbidden_step_ref": {
          "title": "Forbidden Step Ref",
          "type": "string"
        },
        "limitation_note": {
          "title": "Limitation Note",
          "type": "string"
        }
      },
      "required": [
        "forbidden_step_ref",
        "forbidden_step_kind",
        "forbiddance_posture",
        "limitation_note"
      ],
      "title": "ProgrambenchLocalTrialForbiddenStepRow",
      "type": "object"
