      "type": "string"
    },
    "matrix_inclusion_request_ref": {
      "title": "Matrix Inclusion Request Ref",
      "type": "string"
    },
    "matrix_max_added_case_count": {
      "minimum": 1,
      "title": "Matrix Max Added Case Count",
      "type": "integer"
    },
    "matrix_revision_horizon": {
      "const": "local_accounting_revision_only",
      "title": "Matrix Revision Horizon",
      "type": "string"
    },
    "prior_membership_manifest_hash": {
      "title": "Prior Membership Manifest Hash",
      "type": "string"
    },
    "proposed_membership_manifest_hash": {
      "title": "Proposed Membership Manifest Hash",
      "type": "string"
    },
    "representativeness_posture": {
      "const": "not_representative_benchmark_sample",
