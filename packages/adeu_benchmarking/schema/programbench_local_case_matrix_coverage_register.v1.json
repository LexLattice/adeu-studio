        "limitation_note": {
          "title": "Limitation Note",
          "type": "string"
        }
      },
      "required": [
        "coverage_row_ref",
        "case_ref",
        "coverage_kind",
        "coverage_status",
        "coverage_scope_posture",
        "limitation_note"
      ],
      "title": "ProgrambenchLocalCaseMatrixCoverageRow",
      "type": "object"
    }
  },
