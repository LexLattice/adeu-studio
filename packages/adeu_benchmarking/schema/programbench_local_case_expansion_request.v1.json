      "const": "no_official_programbench_authority_granted_by_pb_case_expansion_0a",
      "title": "Official Benchmark Authority Posture",
      "type": "string"
    },
    "representativeness_posture": {
      "const": "not_representative_benchmark_sample",
      "title": "Representativeness Posture",
      "type": "string"
    },
    "requested_case_count": {
      "minimum": 1,
      "title": "Requested Case Count",
      "type": "integer"
