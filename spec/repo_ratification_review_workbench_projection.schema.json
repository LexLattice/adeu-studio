            "blocked_by_authority_boundary",
            "future_family_only",
            "rejected_out_of_scope"
          ],
          "title": "Workbench Projection Posture",
          "type": "string"
        },
        "workbench_projection_ref": {
          "title": "Workbench Projection Ref",
          "type": "string"
        }
      },
      "required": [
        "workbench_projection_ref",
        "visibility_contract_refs",
        "case_view_refs",
        "candidate_refs",
        "permitted_operator_action_postures",
        "forbidden_operator_action_postures",
        "required_later_authority",
        "required_later_authority_rows",
        "workbench_projection_posture",
        "limitation_note"
      ],
      "title": "RepoRatificationReviewWorkbenchProjectionRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "decision_visibility_contract_id": {
      "title": "Decision Visibility Contract Id",
      "type": "string"
    },
    "ratification_review_workbench_projection_id": {
      "title": "Ratification Review Workbench Projection Id",
      "type": "string"
    },
    "review_id": {
      "title": "Review Id",
      "type": "string"
    },
    "schema": {
      "const": "repo_ratification_review_workbench_projection@1",
      "default": "repo_ratification_review_workbench_projection@1",
      "title": "Schema",
      "type": "string"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_set_id": {
      "title": "Source Set Id",
      "type": "string"
    },
    "workbench_boundary_summary": {
      "title": "Workbench Boundary Summary",
      "type": "string"
    },
    "workbench_projection_rows": {
      "items": {
        "$ref": "#/$defs/RepoRatificationReviewWorkbenchProjectionRow"
      },
      "minItems": 1,
      "title": "Workbench Projection Rows",
      "type": "array"
    }
  },
  "required": [
    "ratification_review_workbench_projection_id",
    "review_id",
    "snapshot_id",
    "source_set_id",
    "decision_visibility_contract_id",
    "workbench_projection_rows",
    "workbench_boundary_summary"
  ],
  "title": "RepoRatificationReviewWorkbenchProjection",
  "type": "object"
}
