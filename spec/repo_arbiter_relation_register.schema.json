          "enum": [
            "arbiter_review_needed_later",
            "arbiter_not_needed_for_single_output",
            "arbiter_blocked_by_missing_authority",
            "arbiter_deferred_to_future_family",
            "arbiter_rejected_out_of_scope"
          ],
          "title": "Arbiter Need Posture",
          "type": "string"
        },
        "arbiter_relation_ref": {
          "title": "Arbiter Relation Ref",
          "type": "string"
        },
        "claim_map_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Claim Map Refs",
          "type": "array"
        },
        "limitation_note": {
          "title": "Limitation Note",
          "type": "string"
        },
        "non_truth_guardrail": {
          "title": "Non Truth Guardrail",
          "type": "string"
        },
        "relation_kind": {
          "enum": [
