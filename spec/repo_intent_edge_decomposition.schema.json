        },
        "non_goal_ref": {
          "title": "Non Goal Ref",
          "type": "string"
        },
        "semantic_relation_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Semantic Relation Refs",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        }
