      "title": "Corpus Ingestion Source Index Id",
      "type": "string"
    },
    "review_id": {
      "title": "Review Id",
      "type": "string"
    },
    "schema": {
      "const": "repo_connector_access_review_boundary@1",
      "default": "repo_connector_access_review_boundary@1",
      "title": "Schema",
      "type": "string"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_set_id": {
      "title": "Source Set Id",
      "type": "string"
    }
  },
  "required": [
    "connector_access_review_boundary_id",
    "corpus_ingestion_source_index_id",
    "corpus_ingestion_review_request_id",
    "corpus_ingestion_non_transfer_guardrail_id",
    "review_id",
    "snapshot_id",
    "source_set_id",
    "connector_boundary_rows",
