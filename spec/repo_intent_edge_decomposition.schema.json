      "title": "Schema",
      "type": "string"
    },
    "semantic_intent_contract_id": {
      "title": "Semantic Intent Contract Id",
      "type": "string"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_set_id": {
      "title": "Source Set Id",
      "type": "string"
    }
