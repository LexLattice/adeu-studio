          "title": "Blocker Kind",
          "type": "string"
        },
        "blocker_ref": {
          "title": "Blocker Ref",
          "type": "string"
        },
        "blocking_posture": {
          "enum": [
            "blocking",
            "warning_only",
            "carried_forward",
            "not_applicable",
            "unknown_needs_review"
          ],
          "title": "Blocking Posture",
          "type": "string"
        },
        "candidate_ref": {
          "title": "Candidate Ref",
          "type": "string"
        },
        "case_view_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Case View Refs",
          "type": "array"
        },
        "limitation_note": {
          "title": "Limitation Note",
          "type": "string"
        },
        "required_next_surface": {
          "enum": [
            "v74b_exception_visibility",
            "v74c_visibility_contract",
            "v75_dispatch_review",
            "future_product_review",
            "future_ratification_or_policy_review",
            "future_family_review",
            "deferred_no_selection"
          ],
          "title": "Required Next Surface",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "visible_decision_state": {
          "enum": [
            "ready_for_human_review",
            "blocked_pending_evidence",
            "blocked_pending_authority",
            "blocked_pending_dissent_resolution",
            "recommended_for_later_review",
            "recommended_more_evidence",
            "deferred_to_future_family",
            "rejected_out_of_scope"
          ],
          "title": "Visible Decision State",
          "type": "string"
        }
      },
      "required": [
        "blocker_ref",
        "candidate_ref",
        "case_view_refs",
        "blocker_kind",
        "source_refs",
        "blocking_posture",
        "visible_decision_state",
        "required_next_surface",
        "limitation_note"
      ],
      "title": "RepoProjectionVisibleBlockerRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case_view_rows": {
      "items": {
        "$ref": "#/$defs/RepoOperatorProjectionCaseViewRow"
      },
      "minItems": 1,
      "title": "Case View Rows",
      "type": "array"
    },
    "operator_projection_case_view_id": {
      "title": "Operator Projection Case View Id",
      "type": "string"
    },
    "operator_projection_source_index_id": {
      "title": "Operator Projection Source Index Id",
      "type": "string"
    },
    "projection_boundary_summary": {
      "title": "Projection Boundary Summary",
      "type": "string"
    },
    "review_id": {
      "title": "Review Id",
      "type": "string"
    },
    "schema": {
      "const": "repo_operator_projection_case_view@1",
      "default": "repo_operator_projection_case_view@1",
      "title": "Schema",
      "type": "string"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_set_id": {
      "title": "Source Set Id",
      "type": "string"
    }
  },
  "required": [
    "operator_projection_case_view_id",
    "review_id",
    "snapshot_id",
    "source_set_id",
    "operator_projection_source_index_id",
    "case_view_rows",
    "projection_boundary_summary"
  ],
  "title": "RepoOperatorProjectionCaseView",
  "type": "object"
}
