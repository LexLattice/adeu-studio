          "type": "array"
        },
        "required_review_roles": {
          "items": {
            "enum": [
              "source_index_worker",
              "evidence_review_worker",
              "adversarial_review_worker",
              "schema_validation_worker",
              "tool_run_worker",
              "reconciliation_worker",
              "operator_projection_worker",
              "external_branch_review_worker"
