      "required": [
        "non_goal_ref",
        "source_refs",
        "semantic_relation_refs",
        "non_goal_posture",
        "limitation_note"
      ],
      "title": "RepoIntentEdgeNonGoalRow",
      "type": "object"
    },
    "RepoSemanticObjectRow": {
      "additionalProperties": false,
      "properties": {
