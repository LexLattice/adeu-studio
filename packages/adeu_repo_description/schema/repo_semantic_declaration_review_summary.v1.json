      "title": "Semantic Declaration Non Authority Guardrail Id",
      "type": "string"
    },
    "semantic_declaration_review_summary_id": {
      "title": "Semantic Declaration Review Summary Id",
      "type": "string"
    },
    "semantic_declaration_source_index_id": {
      "title": "Semantic Declaration Source Index Id",
      "type": "string"
    },
    "semantic_operator_class_registry_id": {
      "title": "Semantic Operator Class Registry Id",
      "type": "string"
    },
    "semantic_pointer_lookup_fixture_id": {
      "title": "Semantic Pointer Lookup Fixture Id",
      "type": "string"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_set_id": {
      "title": "Source Set Id",
      "type": "string"
    },
    "summary_rows": {
      "items": {
        "$ref": "#/$defs/RepoSemanticDeclarationReviewSummaryRow"
      },
      "minItems": 1,
      "title": "Summary Rows",
      "type": "array"
