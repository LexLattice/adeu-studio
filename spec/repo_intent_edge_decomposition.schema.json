        "relation_kind": {
          "enum": [
            "requires",
            "constrains",
            "forbids",
            "preserves",
            "realizes",
            "refines",
            "conflicts_with",
            "disambiguates",
            "supersedes",
            "non_goal_of",
            "authority_requires",
            "validation_requires",
            "acceptance_requires",
            "derives_from",
            "must_remain_distinct_from",
            "hands_off_to",
            "validates",
            "blocks",
            "future_family_only"
