        "claim_horizon": {
          "title": "Claim Horizon",
          "type": "string"
        },
        "limitation_note": {
          "title": "Limitation Note",
          "type": "string"
        },
        "observed_or_required_result_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Observed Or Required Result Refs",
          "type": "array"
        },
        "target_claim_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Claim Refs",
          "type": "array"
        },
        "target_namespace_kind": {
          "enum": [
            "dispatch_request",
            "worker_role",
            "io_contract",
            "tool_matrix",
            "candidate",
            "claim_horizon"
