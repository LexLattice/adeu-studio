{
  "$defs": {
    "RepoDispatchSourceRow": {
      "additionalProperties": false,
      "properties": {
        "authority_layer": {
          "enum": [
            "lock",
            "architecture",
            "planning",
            "support",
            "schema",
            "fixture",
            "closeout_evidence"
          ],
          "title": "Authority Layer",
          "type": "string"
        },
        "dispatch_source_role": {
          "enum": [
            "v74_post_projection_handoff_source",
            "visibility_contract_source",
            "workbench_projection_source",
            "family_closeout_source",
            "dogfood_source",
            "review_source",
            "roadmap_context_source",
            "v43_branch_posture_source",
            "absence_marker"
          ],
          "title": "Dispatch Source Role",
          "type": "string"
        },
        "limitation_note": {
          "title": "Limitation Note",
          "type": "string"
        },
        "source_horizon": {
          "title": "Source Horizon",
          "type": "string"
        },
        "source_kind": {
          "enum": [
            "planning_doc",
            "architecture_doc",
            "support_doc",
            "review_input",
            "closeout_doc",
            "evidence_artifact",
            "schema_file",
            "fixture_file",
            "operator_turn",
            "transcript_artifact",
            "model_output",
            "repo_observation",
            "external_artifact"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "source_presence_posture": {
          "enum": [
            "present",
            "missing_expected_support_artifact",
            "not_uploaded_in_review_snapshot",
            "generated_later",
            "external_unavailable",
            "operator_turn_not_committed"
          ],
          "title": "Source Presence Posture",
          "type": "string"
        },
        "source_ref": {
          "title": "Source Ref",
          "type": "string"
        },
        "source_status": {
          "enum": [
            "integrated_shaping_source",
            "available_but_not_integrated",
            "review_pending_input",
            "rejected_or_superseded_source"
          ],
          "title": "Source Status",
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "source_kind",
        "authority_layer",
        "source_status",
        "source_presence_posture",
        "dispatch_source_role",
        "source_horizon",
        "limitation_note"
      ],
      "title": "RepoDispatchSourceRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dispatch_source_index_id": {
      "title": "Dispatch Source Index Id",
      "type": "string"
    },
    "dispatch_source_summary": {
      "title": "Dispatch Source Summary",
      "type": "string"
    },
    "review_id": {
      "title": "Review Id",
      "type": "string"
    },
    "schema": {
      "const": "repo_dispatch_source_index@1",
      "default": "repo_dispatch_source_index@1",
      "title": "Schema",
      "type": "string"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "source_rows": {
      "items": {
        "$ref": "#/$defs/RepoDispatchSourceRow"
      },
      "minItems": 1,
      "title": "Source Rows",
      "type": "array"
    },
    "source_set_id": {
      "title": "Source Set Id",
      "type": "string"
    }
  },
  "required": [
    "dispatch_source_index_id",
    "review_id",
    "snapshot_id",
    "source_set_id",
    "source_rows",
    "dispatch_source_summary"
  ],
  "title": "RepoDispatchSourceIndex",
  "type": "object"
}
