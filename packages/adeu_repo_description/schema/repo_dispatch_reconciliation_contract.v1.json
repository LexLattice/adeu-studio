              "assignment_plan_as_execution",
              "dispatch_review_as_runtime_permission"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Forbidden Inferences",
          "type": "array"
        },
        "handoff_refs": {
          "items": {
            "type": "string"
          },
          "title": "Handoff Refs",
          "type": "array"
        },
        "limitation_note": {
          "title": "Limitation Note",
          "type": "string"
        },
        "reconciliation_plan_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reconciliation Plan Refs",
          "type": "array"
        },
        "required_authority_refs": {
          "items": {
            "type": "string"
