      "type": "object"
    },
    "RepoIntentEdgeConstraintRow": {
      "additionalProperties": false,
      "properties": {
        "constraint_posture": {
          "title": "Constraint Posture",
          "type": "string"
        },
        "constraint_ref": {
          "title": "Constraint Ref",
          "type": "string"
        },
        "limitation_note": {
          "title": "Limitation Note",
          "type": "string"
        },
        "semantic_relation_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Semantic Relation Refs",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        }
