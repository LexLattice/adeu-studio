      "type": "array"
    },
    "local_outcome_posture": {
      "enum": [
        "trial_blocked_by_lifecycle_projection_gap",
        "trial_blocked_by_output_capture_gap",
        "trial_blocked_by_sandbox_violation",
        "trial_inconclusive_local_only",
        "trial_locally_accepted",
        "trial_remand_recommended"
      ],
      "title": "Local Outcome Posture",
      "type": "string"
    },
    "model_ranking_posture": {
      "const": "no_model_ranking_claimed_by_pb_trial_0c",
      "title": "Model Ranking Posture",
      "type": "string"
    },
    "official_submission_posture": {
      "const": "no_official_submission_authority_by_pb_trial_0c",
      "title": "Official Submission Posture",
      "type": "string"
    },
    "runbook_satisfaction_rows": {
      "items": {
        "$ref": "#/$defs/ProgrambenchLocalTrialRunbookSatisfactionRow"
      },
      "minItems": 1,
      "title": "Runbook Satisfaction Rows",
      "type": "array"
    },
    "sandbox_readiness_review_ref": {
      "title": "Sandbox Readiness Review Ref",
      "type": "string"
    },
    "sandbox_satisfaction_rows": {
      "items": {
        "$ref": "#/$defs/ProgrambenchLocalTrialSandboxSatisfactionRow"
      },
      "minItems": 1,
      "title": "Sandbox Satisfaction Rows",
      "type": "array"
    },
    "schema": {
      "const": "programbench_local_trial_outcome_audit@1",
      "title": "Schema",
      "type": "string"
    },
    "trial_docket_ref": {
      "title": "Trial Docket Ref",
      "type": "string"
    },
    "trial_execution_capture_ref": {
      "title": "Trial Execution Capture Ref",
      "type": "string"
    },
    "trial_lifecycle_projection_ref": {
      "title": "Trial Lifecycle Projection Ref",
      "type": "string"
    },
    "trial_outcome_audit_ref": {
      "title": "Trial Outcome Audit Ref",
      "type": "string"
    },
    "trial_runbook_ref": {
      "title": "Trial Runbook Ref",
      "type": "string"
    },
    "trial_worker_dispatch_ref": {
      "title": "Trial Worker Dispatch Ref",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "trial_outcome_audit_ref",
    "trial_docket_ref",
    "trial_runbook_ref",
    "sandbox_readiness_review_ref",
    "trial_worker_dispatch_ref",
    "trial_execution_capture_ref",
    "candidate_artifact_snapshot_ref",
    "trial_lifecycle_projection_ref",
    "local_evidence_rows",
    "runbook_satisfaction_rows",
    "sandbox_satisfaction_rows",
    "local_outcome_posture",
    "hidden_test_equivalence_posture",
    "benchmark_truth_posture",
    "model_ranking_posture",
    "official_submission_posture",
    "limitation_note"
  ],
  "title": "ProgrambenchLocalTrialOutcomeAudit",
  "type": "object"
}
