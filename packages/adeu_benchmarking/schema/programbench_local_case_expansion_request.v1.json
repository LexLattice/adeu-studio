        "selection_rationale_ref": {
          "title": "Selection Rationale Ref",
          "type": "string"
        }
      },
      "required": [
        "selection_rationale_ref",
        "rationale_kind",
        "candidate_case_idea_refs",
        "rationale_scope_posture",
        "limitation_note"
