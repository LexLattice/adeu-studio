      "required": [
        "validation_need_ref",
        "semantic_edge_refs",
        "validation_kind",
        "required_evidence_kind",
        "required_positive_fixture_posture",
        "required_reject_fixture_posture",
        "manual_review_required",
        "tool_applicability_posture",
        "acceptance_not_truth_guardrail",
        "limitation_note"
      ],
      "title": "RepoValidationNeedRow",
      "type": "object"
