          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "limitation_note": {
          "title": "Limitation Note",
          "type": "string"
        },
        "step_kind": {
          "enum": [
            "candidate_snapshot_later",
            "execution_capture_later",
            "lifecycle_projection_later",
            "local_worker_dispatch_later",
            "worker_input_materialization_later"
          ],
          "title": "Step Kind",
          "type": "string"
        },
        "step_ref": {
          "title": "Step Ref",
          "type": "string"
        },
        "step_scope_posture": {
          "const": "planned_for_later_pb_trial_0b_only",
          "title": "Step Scope Posture",
          "type": "string"
        }
      },
      "required": [
        "step_ref",
        "step_kind",
        "step_scope_posture",
        "command_shape_posture",
        "evidence_refs",
        "limitation_note"
