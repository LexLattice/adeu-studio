{
  "$defs": {
    "ProgrambenchLocalTrialLocalEvidenceRow": {
      "additionalProperties": false,
      "properties": {
        "evidence_kind": {
          "enum": [
            "candidate_snapshot_inside_write_scope",
            "execution_capture_available",
            "lifecycle_projection_validated",
            "runbook_satisfaction_reviewed",
            "sandbox_satisfaction_reviewed"
          ],
          "title": "Evidence Kind",
          "type": "string"
        },
        "evidence_posture": {
          "const": "local_trial_evidence_only",
          "title": "Evidence Posture",
          "type": "string"
        },
        "limitation_note": {
          "title": "Limitation Note",
          "type": "string"
        },
        "local_evidence_ref": {
          "title": "Local Evidence Ref",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "local_evidence_ref",
        "evidence_kind",
        "evidence_posture",
        "source_refs",
        "limitation_note"
      ],
      "title": "ProgrambenchLocalTrialLocalEvidenceRow",
      "type": "object"
    },
    "ProgrambenchLocalTrialRunbookSatisfactionRow": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "limitation_note": {
          "title": "Limitation Note",
          "type": "string"
        },
        "runbook_satisfaction_ref": {
          "title": "Runbook Satisfaction Ref",
          "type": "string"
        },
        "satisfaction_kind": {
          "enum": [
            "allowed_steps_satisfied",
            "capture_obligations_satisfied",
            "forbidden_steps_respected",
            "input_hash_preserved"
          ],
          "title": "Satisfaction Kind",
          "type": "string"
        },
        "satisfaction_posture": {
          "enum": [
            "blocked",
            "passed",
            "warning"
          ],
          "title": "Satisfaction Posture",
          "type": "string"
        }
      },
      "required": [
        "runbook_satisfaction_ref",
        "satisfaction_kind",
        "satisfaction_posture",
        "evidence_refs",
        "limitation_note"
      ],
      "title": "ProgrambenchLocalTrialRunbookSatisfactionRow",
      "type": "object"
    },
    "ProgrambenchLocalTrialSandboxSatisfactionRow": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "limitation_note": {
          "title": "Limitation Note",
          "type": "string"
        },
        "sandbox_satisfaction_ref": {
          "title": "Sandbox Satisfaction Ref",
          "type": "string"
        },
        "satisfaction_kind": {
          "enum": [
            "forbidden_access_absent",
            "sandbox_witnesses_satisfied",
            "write_scope_satisfied"
          ],
          "title": "Satisfaction Kind",
          "type": "string"
        },
        "satisfaction_posture": {
          "enum": [
            "blocked",
            "passed",
            "warning"
          ],
          "title": "Satisfaction Posture",
          "type": "string"
        }
      },
      "required": [
        "sandbox_satisfaction_ref",
        "satisfaction_kind",
        "satisfaction_posture",
        "evidence_refs",
        "limitation_note"
      ],
      "title": "ProgrambenchLocalTrialSandboxSatisfactionRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "benchmark_truth_posture": {
      "const": "not_benchmark_truth",
      "title": "Benchmark Truth Posture",
      "type": "string"
    },
    "candidate_artifact_snapshot_ref": {
      "title": "Candidate Artifact Snapshot Ref",
      "type": "string"
    },
    "carried_blocker_refs": {
      "items": {
        "type": "string"
      },
      "title": "Carried Blocker Refs",
      "type": "array"
    },
    "carried_warning_refs": {
      "items": {
        "type": "string"
      },
      "title": "Carried Warning Refs",
      "type": "array"
    },
    "hidden_test_equivalence_posture": {
      "const": "no_hidden_test_equivalence_claimed_by_pb_trial_0c",
      "title": "Hidden Test Equivalence Posture",
      "type": "string"
    },
    "limitation_note": {
      "title": "Limitation Note",
      "type": "string"
    },
    "local_evidence_rows": {
      "items": {
        "$ref": "#/$defs/ProgrambenchLocalTrialLocalEvidenceRow"
