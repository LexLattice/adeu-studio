      "minItems": 1,
      "title": "Requested Case Lineage Refs",
      "type": "array"
    },
    "result_projection_authority_posture": {
      "const": "no_result_projection_authority_granted_by_pb_matrix_inclusion_0a",
      "title": "Result Projection Authority Posture",
      "type": "string"
    },
    "revision_delta_hash": {
      "title": "Revision Delta Hash",
      "type": "string"
    },
    "schema": {
      "const": "programbench_local_matrix_inclusion_request@1",
      "title": "Schema",
      "type": "string"
    },
    "selection_rationale_rows": {
      "items": {
        "$ref": "#/$defs/ProgrambenchLocalMatrixInclusionSelectionRationaleRow"
